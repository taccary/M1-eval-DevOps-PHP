{
    "name": "taccary/oceane",
    "type": "project",
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "require": {
        "oomphinc/composer-installers-extender": "^2.0",
        "npm-asset/bootstrap": "5.3.8",
        "npm-asset/jquery": "3.6.3",
        "npm-asset/datatables.net": "^1.13.1",
        "npm-asset/datatables.net-bs5": "^1.13.1",
        "npm-asset/bootstrap-icons": "1.10.2"
    },
    "extra": {
        "installer-types": ["npm-asset"],
        "installer-paths": {
            "site/vendor/{$name}": ["type:npm-asset"]
        }
    },
    "config": {
        "allow-plugins": {
            "oomphinc/composer-installers-extender": true,
            "composer/installers": true
        }
    }
}
